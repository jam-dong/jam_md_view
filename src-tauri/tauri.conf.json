{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "折简",
  "version": "0.1.1",
  "identifier": "com.jam.mdview",
  "build": {
    "beforeDevCommand": "cmd /c D:\\Work\\Project\\jam_md_view\\tools\\dev-server.cmd",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "折简",
        "width": 1024,
        "height": 768,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": {
      "wix": {
        "language": {
          "en-US": {
            "localePath": "locales/en-US.wxl"
          }
        }
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
